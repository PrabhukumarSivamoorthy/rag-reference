# ─────────────────────────────────────────────────────────────
# Template for the .env file. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.
# ─────────────────────────────────────────────────────────────

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- LangSmith (tracing/observability) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-reference

# --- Chroma (local persistent vector store) ---
# Embedded Chroma needs no API key; this just sets where data is stored.
CHROMA_PERSIST_DIR=./chroma_db
